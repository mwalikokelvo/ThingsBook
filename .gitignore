# Private user data and credentials
*.thingsbook
*.tbvoices
*.dpapi
*.jks
*.keystore
*.p12
*.pfx
*.pem
.env
.env.*
!.env.example

# Books, recordings, and model weights
*.epub
*.pdf
*.mobi
*.azw
*.azw3
*.mp3
*.m4a
*.wav
*.flac
*.safetensors
*.onnx
*.pt
*.pth

# Generated installers and archives
*.exe
*.apk
*.aab
*.msi
*.zip
*.7z

# Build output and dependency caches
node_modules/
target/
dist/
build/
out/
.gradle/
__pycache__/
*.py[cod]

# Local IDE and OS files
.idea/
.vscode/
.DS_Store
Thumbs.db
*.log
*.tmp

# Synthetic test fixtures: original content generated by the make-fixtures.py scripts next to them.
# Real books stay excluded by the rules above; only this folder is re-included.
!work/tests/fixtures/**

# Throwaway key for the side-by-side Android test build (made by .github/workflows/android-test.yml).
test-signing/

# Private Android voice packs bundled with --voice-pack: never committed (the repository is public).
private-voices/

# Playwright for the Chromium tests, installed by work/release.py (npm install --prefix work/test-tools).
work/test-tools/
