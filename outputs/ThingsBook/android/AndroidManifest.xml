<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.thingsbook.library" android:versionCode="11402" android:versionName="1.14.2">
  <queries><intent><action android:name="android.intent.action.TTS_SERVICE"/></intent></queries>
  <uses-permission android:name="android.permission.INTERNET"/>
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
  <uses-permission android:name="android.permission.WAKE_LOCK"/>
  <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35"/>
  <application android:label="ThingsBook" android:icon="@drawable/icon" android:theme="@android:style/Theme.Material.Light.NoActionBar" android:allowBackup="false" android:usesCleartextTraffic="false" android:supportsRtl="true">
